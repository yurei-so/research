[Unit]
Description=Composition Review blinded local operator UI
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/github/research/apparatus/composition-review
ExecStart=/usr/bin/node %h/github/research/apparatus/composition-review/src/server.mjs
Environment=COMPOSITION_REVIEW_HOST=127.0.0.1
Environment=COMPOSITION_REVIEW_PORT=4193
Environment=COMPOSITION_REVIEW_BUNDLE=%h/.local/state/composition-review/prosody-labnote-009-native-stress-v1/review-bundle.json
Environment=COMPOSITION_REVIEW_KEY=%h/.local/state/composition-review/prosody-labnote-009-native-stress-v1/review-key.json
Environment=COMPOSITION_REVIEW_STATE=%h/.local/state/composition-review/prosody-labnote-009-native-stress-v1/judgments.json
Environment=COMPOSITION_REVIEW_TOKEN=%h/.local/state/composition-review/prosody-labnote-009-native-stress-v1/enrollment-token
Environment=COMPOSITION_REVIEW_ASSET_ROOT=%h/.local/state/composition-review/prosody-labnote-009-native-stress-v1/assets
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/composition-review/prosody-labnote-009-native-stress-v1
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
