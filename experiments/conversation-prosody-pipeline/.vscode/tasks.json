{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "venv: create",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/venv",
      "args": ["create"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "venv: install",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/venv",
      "args": ["install"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "venv: recreate",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/venv",
      "args": ["recreate"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "venv: remove",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/venv",
      "args": ["remove"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "example: minimal turn",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/venv",
      "args": ["run", "python", "examples/minimal_turn.py"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "build: wheel",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/venv",
      "args": [
        "run",
        "python",
        "-m",
        "pip",
        "wheel",
        ".",
        "--no-deps",
        "--wheel-dir",
        "dist"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "test: unittest",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/venv",
      "args": ["run", "python", "-m", "unittest", "discover", "-s", "tests"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
