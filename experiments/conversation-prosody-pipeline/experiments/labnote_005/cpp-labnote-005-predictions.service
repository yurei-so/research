[Unit]
Description=Conversation Prosody Pipeline Labnote 005 branch predictions
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/github/research/experiments/conversation-prosody-pipeline
ExecStart=/usr/bin/python3 %h/github/research/experiments/conversation-prosody-pipeline/experiments/labnote_005/run_predictions.py --run-dir %h/github/research/experiments/conversation-prosody-pipeline/artifacts/labnote-005/predictions
Restart=on-abnormal
RestartSec=10
Nice=10
IOSchedulingClass=idle
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
