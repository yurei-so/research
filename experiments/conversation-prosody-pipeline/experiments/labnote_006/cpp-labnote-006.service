[Unit]
Description=Conversation Prosody Pipeline Labnote 006 readiness counterfactuals
After=network-online.target ollama.service

[Service]
Type=simple
WorkingDirectory=%h/github/conversation-prosody-pipeline
ExecStart=/usr/bin/python3 experiments/labnote_006/run_counterfactual.py --run-dir artifacts/labnote-006/counterfactual
Restart=on-failure
RestartSec=15
StandardOutput=append:%h/github/conversation-prosody-pipeline/artifacts/labnote-006/counterfactual/service.log
StandardError=append:%h/github/conversation-prosody-pipeline/artifacts/labnote-006/counterfactual/service.log

[Install]
WantedBy=default.target
