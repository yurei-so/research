[Unit]
Description=Conversation Prosody Pipeline Labnote 007 held-out subscription selector
After=network-online.target ollama.service

[Service]
Type=simple
WorkingDirectory=%h/github/conversation-prosody-pipeline
ExecStart=/usr/bin/python3 experiments/labnote_007/run_selectors.py --source-dir artifacts/labnote-006/counterfactual --run-dir artifacts/labnote-007/selector-heldout --session-start 30 --session-end 39
Restart=on-failure
RestartSec=15
StandardOutput=append:%h/github/conversation-prosody-pipeline/artifacts/labnote-007/selector-heldout/service.log
StandardError=append:%h/github/conversation-prosody-pipeline/artifacts/labnote-007/selector-heldout/service.log

[Install]
WantedBy=default.target
