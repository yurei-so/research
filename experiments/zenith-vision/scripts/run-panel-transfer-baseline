#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
PYTHON="$ROOT/.venv-transfer/bin/python"
if [ ! -x "$PYTHON" ]; then
  echo "panel transfer environment is not installed" >&2
  exit 2
fi
export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
exec "$PYTHON" "$ROOT/experiments/panel_transfer_baseline/run.py"
