      "relations": [
        {
          "target": "voxel-guidance-003",
          "type": "motivated-by",
          "rationale": "The feature-family ablation made the surviving behavior fields concrete enough to test compact machine-native serialization."
        }
      ],
      "href": "labnotes/voxel-guidance-004/",
      "timeline": {
        "follows": [
          "voxel-guidance-003"
